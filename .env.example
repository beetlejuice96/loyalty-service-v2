# Base de datos — Supabase PostgreSQL via TypeORM
# Obtener en: Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Supabase Auth — solo para validar JWT tokens
# Obtener en: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cifrado AES-256 para credenciales de wallet en DB
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Apple APNS — push notifications para Apple Wallet
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# App
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
